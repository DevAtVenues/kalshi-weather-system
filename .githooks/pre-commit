#!/bin/sh
# Commit gate: no change lands without the unit suite AND the end-to-end smoke
# test passing. These have caught real silent breakage; do not bypass with
# --no-verify unless the repo is literally on fire.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-commit] pytest…"
.venv/bin/python -m pytest -q --tb=line || { echo "[pre-commit] BLOCKED: unit tests failing"; exit 1; }
echo "[pre-commit] smoke test…"
.venv/bin/python scripts/smoke_test.py || { echo "[pre-commit] BLOCKED: smoke test failing"; exit 1; }
